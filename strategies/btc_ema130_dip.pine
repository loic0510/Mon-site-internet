//@version=6
// =====================================================================================
// BTC DAILY — EMA 130 PENTE + ACHAT DES KRACHS + SHORT EN MARCHÉ BAISSIER (levier 1)
// 1) Tendance : long dès que l'EMA 130 monte ; retour cash seulement si elle baisse ET que la clôture
//    est > 3 % sous l'EMA (fini les allers-retours quand l'EMA est plate).
// 2) Rebond : en phase cash, achat si la clôture est ≥ 25 % sous l'EMA 130 (capitulation).
//    Revente dès que la clôture repasse au-dessus de l'EMA 20 (après 5 j min.), au plus tard après 40 j,
//    ou stop à −15 % sous le prix d'achat. Puis 20 j sans nouvel achat de rebond (anti-mitraillage).
// 3) Short (option, activée par défaut) : hors position longue, short 100 % si la SMA 365 baisse
//    (vs 10 j avant) ET que la clôture est sous la SMA 365 = marché baissier confirmé. Nécessite un perpétuel.
// Backtest Python (BINANCE:BTCUSDT, 2020-10 → 2026-10, frais+slippage 0,15 %/côté, financement short 10 %/an) :
//   avec short : +6 552 %, 101 %/an, DD max −33,5 %, Sharpe 1,59, 53 ordres
//   long/cash  : +3 377 %,  80 %/an, DD max −33,5 %, Sharpe 1,52, 51 ordres
//   d'origine  : +1 564 %,  60 %/an, DD max −31,9 %, Sharpe 1,33, 57 ordres
// TradingView ne compte pas le financement du perpétuel : son résultat short sera un peu trop optimiste.
// Signal à la clôture journalière, exécution à l'ouverture suivante. Graphique 1D BTC.
// =====================================================================================
strategy("BTC EMA130 + Dip + Short", shorttitle="EMA130 DS", overlay=true, initial_capital=2000,
     default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.15,
     calc_on_every_tick=false, process_orders_on_close=false,
     margin_long=100, margin_short=100, pyramiding=0)

// ------------------------------------------ Paramètres ------------------------------------------
emaLen   = input.int(130,   "Longueur EMA tendance", minval=2)
exitBuf  = input.float(3.0, "Sortie : clôture sous l'EMA de (%)", minval=0, step=0.5) / 100
useDip   = input.bool(true, "Acheter les krachs en phase cash")
dipDepth = input.float(25,  "Rebond : clôture sous l'EMA de (%)", minval=5, step=1) / 100
dipExLen = input.int(20,    "Rebond : sortie au-dessus de l'EMA", minval=2)
dipMin   = input.int(5,     "Rebond : détention minimale (j)", minval=0)
dipMax   = input.int(40,    "Rebond : détention maximale (j)", minval=1)
dipStop  = input.float(15,  "Rebond : stop sous le prix d'achat (%)", minval=1, step=1) / 100
dipCool  = input.int(20,    "Rebond : délai avant nouvel achat (j)", minval=0)
useShort = input.bool(true, "Short en marché baissier")
bearLen  = input.int(365,   "Marché baissier : longueur SMA", minval=10)
bearLook = input.int(10,    "Marché baissier : pente SMA sur (j)", minval=1)
startTs  = input.time(timestamp("2020-10-01 00:00 +0000"), "Début du test (UTC)")

if not (timeframe.isdaily and timeframe.multiplier == 1)
    runtime.error("Appliquer cette stratégie sur un graphique 1D (journalier).")

// ------------------------------------------ Signal ----------------------------------------------
float ema   = ta.ema(close, emaLen)
float emaEx = ta.ema(close, dipExLen)
bool  up    = ema > ema[1]
bool  dn    = ema < ema[1]                      // égalité stricte : on garde l'état en cours
float sma   = ta.sma(close, bearLen)
bool  bear  = sma < sma[bearLook] and close < sma
bool  warm  = bar_index >= math.max(3 * emaLen, bearLen + bearLook)
bool  ready = warm and time >= startTs

var int   trend       = 0                       // 1 = tendance haussière, 0 = cash
var bool  dipOn       = false                   // trade de rebond en cours
var int   dipBars     = 0
var float dipPx       = na
var int   lastDipExit = -100000

if warm and barstate.isconfirmed
    if up
        trend := 1
    else if dn and close < ema * (1 - exitBuf)
        trend := 0

    if trend == 1
        dipOn := false                          // le rebond devient une position de tendance
    else if not dipOn
        if useDip and close < ema * (1 - dipDepth) and bar_index - lastDipExit > dipCool
            dipOn   := true
            dipBars := 0
            dipPx   := close
    else
        dipBars += 1
        if (close > emaEx and dipBars >= dipMin) or dipBars >= dipMax or close < dipPx * (1 - dipStop)
            dipOn       := false
            lastDipExit := bar_index

// cible : 1 = long, -1 = short, 0 = cash
int target = trend == 1 or dipOn ? 1 : useShort and bear ? -1 : 0

sendAlert(string action) =>
    alert('{"action":"' + action + '","symbol":"' + syminfo.ticker + '","price":' + str.tostring(close) + '}', alert.freq_once_per_bar_close)

// ------------------------------------------ Ordres ----------------------------------------------
if ready and barstate.isconfirmed
    if target == 1 and strategy.position_size <= 0
        if strategy.position_size < 0
            sendAlert("cover")
        strategy.entry("Long", strategy.long, comment = trend == 1 ? "EMA↑" : "Krach")
        sendAlert("buy")
    else if target == -1 and strategy.position_size >= 0
        if strategy.position_size > 0
            sendAlert("sell")
        strategy.entry("Short", strategy.short, comment = "Baissier")
        sendAlert("short")
    else if target == 0 and strategy.position_size != 0
        if strategy.position_size > 0
            strategy.close("Long", comment = dipOn[1] ? "Rebond fini" : "EMA↓ cash")
            sendAlert("sell")
        else
            strategy.close("Short", comment = "Fin baissier")
            sendAlert("cover")

// ------------------------------------------ Affichage -------------------------------------------
plot(ema, "EMA", color = up ? color.teal : dn ? color.red : color.gray, linewidth = 2)
plot(ema * (1 - exitBuf),  "Seuil de sortie",   color = color.new(color.red, 60))
plot(ema * (1 - dipDepth), "Zone d'achat krach", color = color.new(color.orange, 40), style = plot.style_circles)
plot(sma, "SMA marché baissier", color = color.new(color.purple, 30))
bgcolor(not ready ? na : strategy.position_size > 0 ? (trend == 1 ? color.new(color.teal, 92) : color.new(color.orange, 88)) : strategy.position_size < 0 ? color.new(color.red, 90) : na)
